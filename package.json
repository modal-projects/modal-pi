{
	"name": "@modal-labs/pi-provider",
	"version": "0.1.0",
	"description": "Modal Endpoints provider extension for Pi",
	"type": "module",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"keywords": [
		"pi-package",
		"modal",
		"provider"
	],
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/modal-projects/modal-pi.git"
	},
	"scripts": {
		"build": "tsc",
		"lint": "biome check .",
		"format": "biome check --write .",
		"type-check": "tsc --noEmit",
		"test": "npm run build && node --test test/*.test.mjs",
		"test:live": "npm run build && node --test test/live.mjs",
		"check": "npm run lint && npm run type-check && npm test"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "^1.5.0",
		"@earendil-works/pi-coding-agent": "^1.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.4",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@types/node": "22.13.10",
		"typescript": "5.9.3"
	}
}
